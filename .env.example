NODE_ENV=development
LOG_LEVEL=info

# Database (SQLite — file path via libsql URL)
SQLITE_URL=file:./data/multiuser.sqlite

# Memory store root (markdown transcripts + memsearch index)
MEMORY_ROOT=./data/memory
# MEMSEARCH_BIN=./.venv/bin/memsearch
# MEMSEARCH_CONFIG_DIR=./data/memory/index
# MEMSEARCH_EMBEDDING_PROVIDER=onnx
# MEMSEARCH_MILVUS_URI=

# Model providers — configure whichever your agent definitions reference
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional local/OpenAI-compatible provider. When LOCAL_MODEL_BASE_URL is set,
# DEFAULT_MODEL_SPEC can use "local:<model-id>" (or change LOCAL_MODEL_PROVIDER).
# Examples:
#   LOCAL_MODEL_BASE_URL=http://localhost:11434/v1
#   DEFAULT_MODEL_SPEC=local:llama3.1:8b
#   LOCAL_MODEL_API_KEY=dummy
LOCAL_MODEL_PROVIDER=local
LOCAL_MODEL_BASE_URL=
LOCAL_MODEL_API_KEY=dummy
LOCAL_MODEL_CONTEXT_WINDOW=131072
LOCAL_MODEL_MAX_TOKENS=8192
LOCAL_MODEL_REASONING=0

# Agent definitions pick their own model via "<provider>:<slug>" specs.
# Examples:
#   openrouter:qwen/qwen-2.5-72b-instruct
#   anthropic:claude-sonnet-4-6
#   openai:gpt-4o-mini

# Discord
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_TEST_INVITE_URL=

# Default model used by CLI live-responder and Discord demo bot
DEFAULT_MODEL_SPEC=openrouter:nvidia/llama-3.3-nemotron-super-49b-v1.5

# Prompt cache retention (short=5min for Anthropic, long=1h Anthropic / 24h OpenAI)
# CACHE_RETENTION=short

# Optional runtime logging flags (0/1)
LOG_LLM_INPUT=0
