{
  "name": "multiuser",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Multi-user, multi-room agent-driven shared fiction platform (Discord-first)",
  "scripts": {
    "dev": "tsx watch src/cli/harness.ts",
    "demo:cli": "node scripts/drive-cli-demo.mjs",
    "probe:llm": "tsx scripts/llm-probe.ts",
    "probe:llm-raw": "tsx scripts/llm-raw-probe.ts",
    "probe:narrator-session": "tsx scripts/narrator-session-probe.ts",
    "serve": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run test/unit test/smoke.test.ts",
    "test:integration": "vitest run test/integration --no-file-parallelism",
    "test:ci": "pnpm typecheck && pnpm test",
    "test:watch": "vitest",
    "test:api": "bash scripts/api-test.sh",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "setup:python": "bash scripts/setup-python.sh",
    "postinstall": "bash scripts/setup-python.sh || true"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.74.0",
    "@earendil-works/pi-ai": "^0.74.0",
    "@hono/node-server": "^1.19.14",
    "@mastra/core": "^0.10.0",
    "@libsql/client": "^0.14.0",
    "croner": "^9.0.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.0",
    "hono": "^4.0.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "typebox": "^1.1.32"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.30.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
